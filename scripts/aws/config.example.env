# Copy this file to .env.aws (ignored by git) and replace every placeholder.
# These values identify infrastructure; credentials continue to come from the
# normal AWS SDK/CLI credential chain or an attached IAM role.

AWS_REGION=us-east-1
ACCOUNT_ID=000000000000
VPC_ID=vpc-REPLACE_ME
VPC_CIDR=10.0.0.0/16
BATCH_SUBNETS=subnet-REPLACE_A,subnet-REPLACE_B
MLFLOW_SUBNET=subnet-REPLACE_A
MLFLOW_SG_ID=sg-REPLACE_ME
MLFLOW_PRIVATE_IP=10.0.0.10

BUCKET=replace-with-globally-unique-bucket-name
ECR_REPO=federated-learning-rmc-defense
STACK_PREFIX=fl-rmc
PRAXIS_PROJECT_TAG=federated-learning-rmc-defense
PRAXIS_OWNER_TAG=replace-me
PRAXIS_PURPOSE_TAG=federated-learning-research

# Capacity controls. The defaults mirror the evaluated retry-from-start design,
# but should be reduced for a smoke deployment.
SPOT_MAX_VCPUS=128
ON_DEMAND_MAX_VCPUS=32
JOB_VCPUS=32
JOB_MEMORY_MIB=122880
RAY_CPUS=32
JOB_TIMEOUT_SECONDS=86400
INSTANCE_TYPES=m6i.8xlarge,m5.8xlarge,m6a.8xlarge,m5a.8xlarge

# Filled after provisioning Aurora and the MLflow host.
AURORA_CLUSTER_ID=fl-rmc-mlflow
AURORA_INSTANCE_ID=fl-rmc-mlflow-1
AURORA_DB_USER=mlflow
AURORA_DB_NAME=mlflow
AURORA_ENGINE_VERSION=16.8
# 0.5 works across more Aurora Serverless v2 engine/region combinations. Set
# this to 0 only where auto-pause is supported.
AURORA_MIN_ACU=0.5
AURORA_MAX_ACU=16
AURORA_AUTO_PAUSE_SECONDS=300
AURORA_ENDPOINT=replace-me.cluster-example.us-east-1.rds.amazonaws.com
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:replace-me
MLFLOW_TRACKING_URI=http://10.0.0.10:5000
