{
  "name": "rmc_szelag_brfss",
  "description": "Szelag-faithful RMC scenario using BRFSS dataset (arXiv:2504.03077v1). 11 honest + 9 malicious (45% malicious fraction). NO WARMUP: malicious clients attack with Gaussian noise (sigma=2.0) from round 1 (matching Szelag's actual code, not paper description). Phase 1: rounds 1-15 all 20 clients present, 9 attacking with gaussian_noise. Phase 2: round 16 client_19 absent (detected/kicked). Phase 3: rounds 17-50 client_19 reconnects as client_19_new with ALIE attack. NOTE: Flower does NOT have persistent optimizer across rounds, so the 'ticking time bomb' degradation seen in Szelag's code will NOT occur. We expect Flower Krum accuracy to be HIGHER than the 0.504 reproduction.",
  "dataset": "brfss_20",
  "num_rounds": 50,
  "seed": 42,
  "clients": {
    "client_0": {"physical_id": 0},
    "client_1": {"physical_id": 1},
    "client_2": {"physical_id": 2},
    "client_3": {"physical_id": 3},
    "client_4": {"physical_id": 4},
    "client_5": {"physical_id": 5},
    "client_6": {"physical_id": 6},
    "client_7": {"physical_id": 7},
    "client_8": {"physical_id": 8},
    "client_9": {"physical_id": 9},
    "client_10": {"physical_id": 10},
    "client_11": {"physical_id": 11},
    "client_12": {"physical_id": 12},
    "client_13": {"physical_id": 13},
    "client_14": {"physical_id": 14},
    "client_15": {"physical_id": 15},
    "client_16": {"physical_id": 16},
    "client_17": {"physical_id": 17},
    "client_18": {"physical_id": 18},
    "client_19": {"physical_id": 19},
    "client_19_new": {"physical_id": 20}
  },
  "schedule": [
    {
      "rounds": [1, 15],
      "participants": [
        "client_0", "client_1", "client_2", "client_3", "client_4",
        "client_5", "client_6", "client_7", "client_8", "client_9",
        "client_10", "client_11", "client_12", "client_13", "client_14",
        "client_15", "client_16", "client_17", "client_18", "client_19"
      ],
      "attacks": {
        "client_11": {"type": "gaussian_noise", "params": {"sigma": 2.0}},
